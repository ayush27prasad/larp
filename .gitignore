*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Generated by XcodeGen from project.yml — never edit or commit. The exception
# is SwiftPM's lockfile inside it, so every clone builds the same dependency
# versions. Git can't re-include a file under an ignored folder, hence the
# folder-by-folder unignoring; it must come after *.xcworkspace/ above.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Build output
DerivedData/
build/
.build/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
Packages/

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Tooling
.sourcekit-lsp/
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editors
.idea/
.vscode/
*.swp
*~

# Secrets — never commit signing material or local overrides
*.p12
*.mobileprovision
*.cer
Local.xcconfig
.env
.env.*
